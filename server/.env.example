# ============================================
# TradeAI Pro Backend - Variables de Entorno
# ============================================

# Configuración del servidor
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ============================================
# INTERACTIVE BROKERS (TWS/Gateway)
# ============================================
# Para Paper Trading (simulación): Puerto 7497
# Para Live Trading (dinero real): Puerto 7496
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ============================================
# AUTENTICACIÓN JWT
# ============================================
# CAMBIAR EN PRODUCCIÓN - Generar con: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# CRYPTO EXCHANGES (CCXT)
# ============================================
# Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# Coinbase
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_SECRET=your_coinbase_secret

# Kraken
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET=your_kraken_secret

# Bitso (LATAM)
BITSO_API_KEY=your_bitso_api_key
BITSO_SECRET=your_bitso_secret

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# BASE DE DATOS (opcional - para producción)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/tradeai
# REDIS_URL=redis://localhost:6379
